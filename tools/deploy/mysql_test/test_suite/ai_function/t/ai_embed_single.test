--disable_query_log
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('embed_reg_ep', '{"url":"http://127.0.0.1:18082/openai/retry","provider":"openai"}');
set ob_query_timeout=60000000;
--enable_query_log
select json_length(ai_embed('embed_reg','retry',2)) as retry_dimension;
select 1+1 as sql_still_works;
drop table embed_reg_text;
--disable_query_log
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('embed_reg_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('embed_reg');
--enable_query_log
--exec python3 mysql_test/test_suite/ai_function/include/ai_embed_mock.py stop
