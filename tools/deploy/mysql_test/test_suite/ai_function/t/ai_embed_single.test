# AI_EMBED: scalar semantics, long text, indexed protocols and invalid responses.
connection default;
--exec python3 mysql_test/test_suite/ai_function/include/ai_embed_mock.py start
--disable_query_log
--disable_result_log
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('embed_reg_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('embed_reg');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('embed_reg', '{"type":"dense_embedding","model_name":"regression-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('embed_reg_ep', '{"ai_model_name":"embed_reg","url":"http://127.0.0.1:18082/openai/normal","access_key":"test","provider":"openai"}');
--enable_result_log
--enable_query_log
select json_length(ai_embed('embed_reg', 'hello')) as default_dimension;
select json_length(ai_embed('embed_reg', 'hello', 5)) as explicit_dimension;
select json_length(ai_embed('embed_reg', 'hello', 4096)) as long_result_dimension;
select json_valid(ai_embed('embed_reg', '中文🙂')) as valid_json;
select ai_embed('embed_reg', null) is null as null_propagates;
create table embed_reg_text(id int primary key, content longtext);
insert into embed_reg_text values(1,repeat('长',100000)),(2,null),(3,'abc');
select id, json_extract(ai_embed('embed_reg',content,2),'$[0]') as byte_length from embed_reg_text order by id;
--exec python3 mysql_test/test_suite/ai_function/include/ai_embed_mock.py clear
--error 1210
select ai_embed('embed_reg','hello',0);
--error 1210
select ai_embed('embed_reg','hello',-1);
--error 1210
select ai_embed('embed_reg','hello',2.5);
--error 1210
select ai_embed('embed_reg','hello',null);
--error 1210
select ai_embed('embed_reg','');
select ai_embed('embed_reg',null) is null as no_null_request;
--exec python3 mysql_test/test_suite/ai_function/include/ai_embed_mock.py assert-empty
--disable_query_log
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('embed_reg_ep', '{"url":"http://127.0.0.1:18082/openai/shuffle","provider":"openai"}');
--enable_query_log
select json_extract(ai_embed('embed_reg','openai',2),'$[0]') as openai_value;
--disable_query_log
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('embed_reg_ep', '{"url":"http://127.0.0.1:18082/openai/duplicate"}');
--enable_query_log
--error 4070
select ai_embed('embed_reg','bad response',2);
--disable_query_log
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('embed_reg_ep', '{"url":"http://127.0.0.1:18082/openai/missing"}');
--enable_query_log
--error 4070
select ai_embed('embed_reg','bad response',2);
--disable_query_log
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('embed_reg_ep', '{"url":"http://127.0.0.1:18082/openai/out-of-range"}');
--enable_query_log
--error 4070
select ai_embed('embed_reg','bad response',2);
--disable_query_log
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('embed_reg_ep', '{"url":"http://127.0.0.1:18082/openai/no-index"}');
--enable_query_log
