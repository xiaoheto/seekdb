--error 4070
select ai_embed('embed_reg','bad response',2);
--disable_query_log
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('embed_reg_ep', '{"url":"http://127.0.0.1:18082/openai/bad-data","provider":"openai"}');
